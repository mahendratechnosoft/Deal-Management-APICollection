meta {
  name: /admin/createEmailTemplate
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/createEmailTemplate
  body: json
  auth: inherit
}

body:json {
  {
    "templateName": "AMC Notification",
    "subject": "Your Annual Maintenance Contract (AMC) Details",
    "emailBody": "<div style=\"font-family: Arial, Helvetica, sans-serif; color:#333; font-size:14px; line-height:1.6;\"><p>Dear {{customerName}},</p><p>This email is to provide you with the details of your Annual Maintenance Contract (AMC) with us.</p><h3 style=\"color:#1a237e; border-bottom:2px solid #1a237e; padding-bottom:5px;\">AMC Details</h3><table width=\"100%\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;\"><tr><td width=\"35%\"><strong>Company Name</strong></td><td>{{companyName}}</td></tr><tr style=\"background-color:#f9f9f9;\"><td><strong>Customer Name</strong></td><td>{{customerName}}</td></tr><tr><td><strong>Customer Email</strong></td><td>{{customerEmail}}</td></tr><tr style=\"background-color:#f9f9f9;\"><td><strong>Customer Phone</strong></td><td>{{customerPhone}}</td></tr><tr><td><strong>AMC Scope</strong></td><td>{{amcScope}}</td></tr><tr style=\"background-color:#f9f9f9;\"><td><strong>Start Date</strong></td><td>{{amcStartDate}}</td></tr><tr><td><strong>End Date</strong></td><td>{{amcEndDate}}</td></tr><tr style=\"background-color:#f9f9f9;\"><td><strong>AMC Amount</strong></td><td>{{amcAmount}}</td></tr><tr><td><strong>Paid Amount</strong></td><td>{{paidAmount}}</td></tr><tr style=\"background-color:#f9f9f9;\"><td><strong>Payment Status</strong></td><td>{{paymentStatus}}</td></tr></table><h3 style=\"color:#1a237e; border-bottom:2px solid #1a237e; padding-bottom:5px; margin-top:25px;\">Service Provider Details</h3><table width=\"100%\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;\"><tr><td width=\"35%\"><strong>Company Name</strong></td><td>{{myCompanyName}}</td></tr><tr style=\"background-color:#f9f9f9;\"><td><strong>Email</strong></td><td>{{myEmail}}</td></tr><tr><td><strong>Phone</strong></td><td>{{myPhone}}</td></tr><tr style=\"background-color:#f9f9f9;\"><td><strong>Website</strong></td><td><a href=\"{{myWebsite}}\" target=\"_blank\" style=\"color:#0056b3;\">{{myWebsite}}</a></td></tr><tr><td><strong>Address</strong></td><td>{{myAddress}}</td></tr><tr style=\"background-color:#f9f9f9;\"><td><strong>GST Number</strong></td><td>{{myGst}}</td></tr><tr><td><strong>PAN Number</strong></td><td>{{myPan}}</td></tr></table><p style=\"margin-top:30px;\">If you have any questions or require support, please feel free to reach out to us.</p><p>Best regards,<br><strong>{{myCompanyName}}</strong><br>Email: {{myEmail}}<br>Phone: {{myPhone}}</p></div>",
    "category": "AMC",
    "triggerEvent": "AMC_REMINDER",
    "isActive": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
