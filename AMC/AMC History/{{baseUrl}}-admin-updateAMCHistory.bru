meta {
  name: {{baseUrl}}/admin/updateAMCHistory
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/{{role}}/updateAMCHistory?sendMailToCustomer=true
  body: json
  auth: bearer
}

params:query {
  sendMailToCustomer: true
}

auth:bearer {
  token: {{bearerToken}}
}

body:json {
  {
    "amcId": "ac110008-9f65-1865-819f-65f5d58e000b",
    "amcStartDate": "2025-01-01",
    "amcEndDate": "2026-01-01",
    "amcAmount": 25000.0,
    "amcScope": "Full website maintenance, bug fixes, security patches updated",
    "amcRecycleType": "Yearly",
    "paidAmount": 25000
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
